# Copy this file to .env and fill in real values.
# .env must NEVER be committed to source control — it is listed in .gitignore.

DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finance

# Set to "true", "1", or "yes" to enable SQLAlchemy SQL statement logging.
# Keep this "false" (or unset) in production — logs may contain sensitive data.
DB_ECHO=false
